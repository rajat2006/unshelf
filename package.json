{
  "name": "unshelf",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "turbo run build",
    "ci:product": "pnpm run ci:product:build && pnpm run ci:product:typecheck && pnpm run ci:product:test",
    "ci:product:build": "turbo run build --filter=@unshelf/web --filter=@unshelf/api --filter=@unshelf/shared",
    "ci:product:test": "turbo run test:product --filter=@unshelf/web --filter=@unshelf/api --filter=@unshelf/shared",
    "ci:product:typecheck": "turbo run typecheck --filter=@unshelf/web --filter=@unshelf/api --filter=@unshelf/shared",
    "db:generate": "turbo run db:generate",
    "dev": "turbo run dev",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "prettier": "3.9.6",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0"
  }
}
