# Both app images build from the repo root, so this root .dockerignore keeps the
# build context small and reproducible: never ship host node_modules, build
# output, local env, or VCS/tooling state into the image (deps are installed
# fresh from the lockfile inside the build).
node_modules
**/node_modules
dist
**/dist
build
**/build
.turbo
**/.turbo
coverage
**/coverage
.env
**/.env
.npmrc
**/.npmrc
.pnpm-store
**/.pnpm-store
.git
.gitignore
.DS_Store
*.log
docs
