# Caddy serves the built SPA. It does not proxy /api: in production Traefik
# routes PathPrefix(`/api`) to the API service and sends everything else here.
:80 {
	root * /usr/share/caddy

	# Lightweight liveness endpoint for Traefik and uptime checks.
	handle /healthz {
		respond "ok" 200
	}

	handle /runtime-config.js {
		header Cache-Control "no-store"
		file_server
	}

	# Vite fingerprints these assets, so they can be cached indefinitely.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Fall back to the app shell for client-side routes and deep links.
	handle {
		try_files {path} {path}/ /index.html
		file_server
	}
}
