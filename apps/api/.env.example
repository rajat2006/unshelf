DATABASE_URL=postgres://unshelf:unshelf@localhost:5432/unshelf
DATABASE_TIME_ZONE=UTC
PORT=3001
LOG_LEVEL=info
# Exact browser origin allowed to present Clerk sessions to the API.
PUBLIC_ORIGIN=http://localhost:5173
# Clerk (auth) — from the Clerk dashboard. Secret key stays server-side.
# Required dashboard config (Google-only, open sign-up): docs/clerk-setup.md
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
# Discover is enabled for local development. Use a YouTube Data API v3 key;
# this secret stays server-side and must never be copied to the web environment.
DISCOVER_ENABLED=true
YOUTUBE_API_KEY=...
